class Main {
    function void main() {
        var int x, y;
        var int prevX, prevY;

        do Screen.setColor(true);
        do Screen.drawLine(128, 0, 128, 255); 
        do Screen.drawLine(0, 128, 255, 128); 

        let x = -32;
        while (x <= 32) {
            let y = Main.f(x); 
            if ((y >= -32) & (y <= 32)) {
                let x = 128 + x;
                let y = 128 - y;

                // Draw a point
                do Screen.setColor(true);
                do Screen.drawPixel(x, y);

                // Draw a line from the previous point (linear interpolation)
                if (x > -32) {
                    do Screen.drawLine(prevX, prevY, x, y);
                }

                // Save current point for interpolation
                let prevX = x;
                let prevY = y;
            }
            let x = x + 1;
        }
        return;
    }

    function int f(int x) {
        return x;
    }
}