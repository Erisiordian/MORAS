class Main {
    function void main() {
        var Array arr;
        var int length;
        let arr = Array.new(10); 
        let arr[0] = 5;
        let arr[1] = 3;
        let arr[2] = 8;
        let arr[3] = 4;
        let arr[4] = 2;
        let arr[5] = 7;
        let arr[6] = 1;
        let arr[7] = 10;
        let arr[8] = 6;
        let arr[9] = 9;
        let length = 10;

        do Main.printArray(arr, length); 
        do Main.quicksort(arr, 0, length - 1); 
        do Main.printArray(arr, length); 
        return;
    }

    function void quicksort(Array arr, int low, int high) {
        var int pivotIndex;
        if (low < high) {
            let pivotIndex = Main.partition(arr, low, high);
            do Main.quicksort(arr, low, pivotIndex - 1);
            do Main.quicksort(arr, pivotIndex + 1, high);
        }
        return;
    }

    function int partition(Array arr, int low, int high) {
        var int pivot, i, j, temp;
        let pivot = arr[high];
        let i = low - 1;
        for (let j = low; j < high; j = j + 1) {
            if (arr[j] <= pivot) {
                let i = i + 1;
                let temp = arr[i];
                let arr[i] = arr[j];
                let arr[j] = temp;
            }
        }
        let temp = arr[i + 1];
        let arr[i + 1] = arr[high];
        let arr[high] = temp;
        return i + 1;
    }

    function void printArray(Array arr, int length) {
        var int i;
        let i = 0;
        while (i < length) {
            do Output.printInt(arr[i]);
            do Output.printString(" ");
            let i = i + 1;
        }
        do Output.println();
        return;
    }
}
